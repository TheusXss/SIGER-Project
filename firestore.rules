    match /qrCodes/{qrId} {
      allow read: if estaAutenticado() && (ehAdmin() || resource.data.ativo == true);
      allow create: if ehAdmin() &&
        request.resource.data.ativo == true &&
        request.resource.data.criadoPor == request.auth.uid &&
        request.resource.data.criadoEm == request.time &&
        request.resource.data.tipo in ['aulaExtra', 'local'] &&
        request.resource.data.alvoId is string &&
        request.resource.data.nome is string &&
        request.resource.data.localId is string &&
        request.resource.data.localNome is string &&
        request.resource.data.keys().hasOnly(['tipo', 'alvoId', 'nome', 'localId', 'localNome', 'ativo', 'inicio', 'fim', 'criadoPor', 'criadoEm']);
      allow update: if ehAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo', 'invalidadoEm', 'invalidadoPor']) &&
        ((request.resource.data.ativo == false && request.resource.data.invalidadoEm == request.time && request.resource.data.invalidadoPor == request.auth.uid) ||
          (request.resource.data.ativo == true && resource.data.ativo == false));
      allow delete: if false;
    }

    match /calendarEvents/{eventId} {
      allow read: if estaAutenticado();
      allow create, update, delete: if ehAdmin();
    }

    match /aulasExtrasSolicitacoes/{solicitacaoId} {
      allow read: if estaAutenticado() &&
        (ehAdmin() || (ehProfessor() && resource.data.professorUid == request.auth.uid));
      allow create: if estaAutenticado() &&
        ((contaInstitucionalValida('professor') &&
          request.resource.data.professorUid == request.auth.uid &&
          request.resource.data.professorNome == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name &&
          request.resource.data.solicitanteRole == 'professor') ||
         (ehAdmin() &&
          request.resource.data.professorUid == '' &&
          request.resource.data.professorNome == '' &&
          request.resource.data.solicitanteRole == 'admin')) &&
        request.resource.data.solicitanteUid == request.auth.uid &&
        request.resource.data.solicitanteNome == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name &&
        localDisponivel(request.resource.data.localId, request.resource.data.localNome) &&
        request.resource.data.status == 'pendente' &&
        request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 &&
        request.resource.data.descricao is string && request.resource.data.descricao.size() > 0 &&
        request.resource.data.materia is string && request.resource.data.materia.size() > 0 &&
        request.resource.data.data is string && request.resource.data.data.size() == 10 &&
        request.resource.data.horario is string &&
        turmasCorrespondem(request.resource.data.turmaIds, request.resource.data.turmas) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if ehAdmin() &&
        resource.data.status == 'pendente' &&
        request.resource.data.status in ['aprovada', 'recusada'] &&
        request.resource.data.administradorUid == request.auth.uid &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'administradorUid', 'administradorNome', 'justificativaRecusa', 'aulaId', 'updatedAt']) &&
        ((request.resource.data.status == 'recusada' &&
          request.resource.data.justificativaRecusa is string &&
          request.resource.data.justificativaRecusa.size() > 0 &&
          request.resource.data.aulaId == '') ||
         (request.resource.data.status == 'aprovada' &&
          request.resource.data.justificativaRecusa == '' &&
          request.resource.data.aulaId == solicitacaoId &&
          getAfter(/databases/$(database)/documents/aulasExtras/$(solicitacaoId)).data.solicitacaoId == solicitacaoId &&
          getAfter(/databases/$(database)/documents/aulasExtras/$(solicitacaoId)).data.professorUid == resource.data.professorUid &&
          getAfter(/databases/$(database)/documents/aulasExtras/$(solicitacaoId)).data.localId == resource.data.localId &&
          getAfter(/databases/$(database)/documents/aulasExtras/$(solicitacaoId)).data.localNome == resource.data.localNome &&
          getAfter(/databases/$(database)/documents/aulasExtras/$(solicitacaoId)).data.turmaIds == resource.data.turmaIds));
      allow delete: if false;
    }

    match /aulasExtras/{aulaId} {
      allow read: if ehAdmin() ||
        (ehProfessor() && resource.data.professorUid == request.auth.uid) ||
        (estaAutenticado() && ehAlunoDaTurma(resource.data.turmaIds));
      allow create: if ehAdmin() &&
        request.resource.data.solicitacaoId == aulaId &&
        request.resource.data.statusAula == 'agendada' &&
        exists(/databases/$(database)/documents/aulasExtrasSolicitacoes/$(aulaId)) &&
        get(/databases/$(database)/documents/aulasExtrasSolicitacoes/$(aulaId)).data.status == 'pendente' &&
        getAfter(/databases/$(database)/documents/aulasExtrasSolicitacoes/$(aulaId)).data.status == 'aprovada' &&
        getAfter(/databases/$(database)/documents/aulasExtrasSolicitacoes/$(aulaId)).data.aulaId == aulaId &&
        request.resource.data.professorUid == get(/databases/$(database)/documents/aulasExtrasSolicitacoes/$(aulaId)).data.professorUid &&
        request.resource.data.localId == get(/databases/$(database)/documents/aulasExtrasSolicitacoes/$(aulaId)).data.localId &&
        request.resource.data.localNome == get(/databases/$(database)/documents/aulasExtrasSolicitacoes/$(aulaId)).data.localNome &&
        localDisponivel(request.resource.data.localId, request.resource.data.localNome) &&
        request.resource.data.turmaIds == get(/databases/$(database)/documents/aulasExtrasSolicitacoes/$(aulaId)).data.turmaIds;
      allow update: if (
          ehProfessor() &&
          resource.data.professorUid == request.auth.uid &&
          aulaEstaAberta(resource.data.statusAula) &&
          request.resource.data.statusAula == 'finalizada' &&
          request.resource.data.finalizadaPor == request.auth.uid &&
          request.resource.data.finalizadaEm == request.time &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['statusAula', 'finalizadaEm', 'finalizadaPor'])
        ) || (
          ehAdmin() &&
          resource.data.statusAula != 'cancelada' &&
          request.resource.data.statusAula == 'cancelada' &&
          request.resource.data.canceladaPor == request.auth.uid &&
          request.resource.data.canceladaEm == request.time &&
          request.resource.data.motivoCancelamento == getAfter(/databases/$(database)/documents/aulasExtrasExclusaoSolicitacoes/$(aulaId)).data.observacao &&
          getAfter(/databases/$(database)/documents/aulasExtrasExclusaoSolicitacoes/$(aulaId)).data.status == 'aprovado' &&
          getAfter(/databases/$(database)/documents/aulasExtrasExclusaoSolicitacoes/$(aulaId)).data.administradorUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['statusAula', 'canceladaEm', 'canceladaPor', 'motivoCancelamento'])
        );
      allow delete: if false;

      match /inscritos/{alunoUid} {
        allow read: if estaAutenticado() && (
          ehAdmin() ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'aluno' &&
            request.auth.uid == alunoUid &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.turmaId in
              get(/databases/$(database)/documents/aulasExtras/$(aulaId)).data.turmaIds) ||
          (ehProfessor() && get(/databases/$(database)/documents/aulasExtras/$(aulaId)).data.professorUid == request.auth.uid)
        );
        allow create: if estaAutenticado() &&
          request.auth.uid == alunoUid &&
          get(/databases/$(database)/documents/users/$(alunoUid)).data.role == 'aluno' &&
