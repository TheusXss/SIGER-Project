        request.resource.data.status == 'pendente' &&
        request.resource.data.observacao is string && request.resource.data.observacao.size() > 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.keys().hasOnly(['aulaId', 'professorUid', 'professorNome', 'aulaTitulo', 'observacao', 'historico', 'status', 'administradorUid', 'respostaAdmin', 'createdAt', 'updatedAt']);
      allow update: if ehAdmin() &&
        resource.data.status == 'pendente' &&
        request.resource.data.status in ['aprovado', 'recusado'] &&
        request.resource.data.administradorUid == request.auth.uid &&
        request.resource.data.respostaAdmin is string &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'administradorUid', 'respostaAdmin', 'updatedAt']) &&
        (request.resource.data.status != 'aprovado' ||
          getAfter(/databases/$(database)/documents/aulasExtras/$(aulaId)).data.statusAula == 'cancelada');
      allow delete: if false;
    }

    // Contas previamente autorizadas para cadastro individual.
    // A leitura é necessária no fluxo de cadastro e na administração.
    match /verifiedAccounts/{accountId} {
      allow read: if true;
      allow create, delete: if ehAdmin();
      allow update: if ehAdmin() || (
        estaAutenticado() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verifiedAccountId == accountId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == resource.data.tipo &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.matricula == resource.data.matricula &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == resource.data.email &&
        request.auth.token.email == resource.data.email &&
        resource.data.status == 'nao_cadastrada' &&
        request.resource.data.authUid == request.auth.uid &&
        request.resource.data.status == 'cadastrada' &&
        request.resource.data.diff(resource.data).affectedKeys()
