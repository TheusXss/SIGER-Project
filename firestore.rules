          request.resource.data.keys().hasOnly(['uid', 'alunoNome', 'tipo', 'alvoId', 'alvoNome', 'data', 'localId', 'localNome', 'qrId', 'status', 'registradaEm']);
        allow update, delete: if false;
      }
    }

    match /aulasExtrasExclusaoSolicitacoes/{aulaId} {
      allow read: if ehAdmin() || (ehProfessor() && resource.data.professorUid == request.auth.uid);
      allow create: if ehProfessor() &&
        request.resource.data.aulaId == aulaId &&
        request.resource.data.professorUid == request.auth.uid &&
        request.resource.data.professorNome == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name &&
