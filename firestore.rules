          request.resource.data.tipo == 'aulaExtra' &&
          request.resource.data.alvoId == aulaId &&
          request.resource.data.alvoNome == get(/databases/$(database)/documents/aulasExtras/$(aulaId)).data.titulo &&
          request.resource.data.data == get(/databases/$(database)/documents/aulasExtras/$(aulaId)).data.data &&
          request.resource.data.localId == get(/databases/$(database)/documents/aulasExtras/$(aulaId)).data.localId &&
          request.resource.data.localNome == get(/databases/$(database)/documents/aulasExtras/$(aulaId)).data.localNome &&
          aulaEstaAberta(get(/databases/$(database)/documents/aulasExtras/$(aulaId)).data.statusAula) &&
