          request.resource.data.qrId is string &&
          exists(/databases/$(database)/documents/qrCodes/$(request.resource.data.qrId)) &&
          get(/databases/$(database)/documents/qrCodes/$(request.resource.data.qrId)).data.ativo == true &&
          get(/databases/$(database)/documents/qrCodes/$(request.resource.data.qrId)).data.tipo == 'aulaExtra' &&
          get(/databases/$(database)/documents/qrCodes/$(request.resource.data.qrId)).data.alvoId == aulaId &&
