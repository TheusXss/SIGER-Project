          request.resource.data.alunoNome == get(/databases/$(database)/documents/users/$(alunoUid)).data.name &&
          request.resource.data.matricula == get(/databases/$(database)/documents/users/$(alunoUid)).data.matricula &&
          request.resource.data.turmaId == get(/databases/$(database)/documents/users/$(alunoUid)).data.turmaId &&
          request.resource.data.turmaId in get(/databases/$(database)/documents/aulasExtras/$(aulaId)).data.turmaIds &&
          aulaEstaAberta(get(/databases/$(database)/documents/aulasExtras/$(aulaId)).data.statusAula) &&
          request.resource.data.presenca == 'pendente' &&
          request.resource.data.inscritoEm == request.time &&
          request.resource.data.keys().hasOnly(['alunoUid', 'alunoNome', 'matricula', 'turmaId', 'inscritoEm', 'presenca']);
        allow update: if ehProfessor() &&
          get(/databases/$(database)/documents/aulasExtras/$(aulaId)).data.professorUid == request.auth.uid &&
          aulaEstaAberta(get(/databases/$(database)/documents/aulasExtras/$(aulaId)).data.statusAula) &&
          resource.data.presenca in ['pendente', 'presente', 'ausente'] &&
          request.resource.data.presenca in ['presente', 'ausente'] &&
          request.resource.data.presencaAtualizadaPor == request.auth.uid &&
          request.resource.data.presencaAtualizadaEm == request.time &&
          request.resource.data.diff(resource.data).affectedKeys()
