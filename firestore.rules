    function ehProfessor() {
      return estaAutenticado() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'professor';
    }

    function ehAlunoDaTurma(turmaIds) {
      return estaAutenticado() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'aluno' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.turmaId in turmaIds;
    }

    function aulaEstaAberta(statusAula) {
      return statusAula == 'agendada' || statusAula == null;
    }

    function contaInstitucionalValida(tipo) {
      let perfil = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let conta = get(/databases/$(database)/documents/verifiedAccounts/$(perfil.verifiedAccountId)).data;
      return perfil.role == tipo &&
        conta.tipo == tipo &&
        conta.status == 'cadastrada' &&
        conta.authUid == request.auth.uid &&
        conta.email == perfil.email &&
        conta.email == request.auth.token.email &&
        conta.matricula == perfil.matricula;
    }

    function perfilVerificadoNoCadastro() {
      let perfil = request.resource.data;
      return perfil.verifiedAccountId is string &&
        exists(/databases/$(database)/documents/verifiedAccounts/$(perfil.verifiedAccountId)) &&
        get(/databases/$(database)/documents/verifiedAccounts/$(perfil.verifiedAccountId)).data.status == 'nao_cadastrada' &&
        get(/databases/$(database)/documents/verifiedAccounts/$(perfil.verifiedAccountId)).data.tipo == perfil.role &&
        get(/databases/$(database)/documents/verifiedAccounts/$(perfil.verifiedAccountId)).data.email == perfil.email &&
        perfil.email == request.auth.token.email &&
        get(/databases/$(database)/documents/verifiedAccounts/$(perfil.verifiedAccountId)).data.matricula == perfil.matricula &&
        (perfil.role != 'aluno' || (
          get(/databases/$(database)/documents/verifiedAccounts/$(perfil.verifiedAccountId)).data.turmaId == perfil.turmaId &&
          get(/databases/$(database)/documents/verifiedAccounts/$(perfil.verifiedAccountId)).data.turma == perfil.turmaNome
        ));
    }

    function turmaCorresponde(turmaIds, turmas, indice) {
      let turma = get(/databases/$(database)/documents/turmas/$(turmaIds[indice])).data;
      return turmas[indice].id == turmaIds[indice] &&
        turmas[indice].nome == turma.nome;
    }

    function localDisponivel(localId, localNome) {
      return localId is string && localNome is string &&
        exists(/databases/$(database)/documents/locations/$(localId)) &&
        get(/databases/$(database)/documents/locations/$(localId)).data.status == 'Disponível' &&
        get(/databases/$(database)/documents/locations/$(localId)).data.name == localNome;
    }

    function turmasCorrespondem(turmaIds, turmas) {
      return turmaIds is list && turmaIds.size() >= 1 && turmaIds.size() <= 7 &&
        turmas is list && turmas.size() == turmaIds.size() &&
        turmaCorresponde(turmaIds, turmas, 0) &&
        (turmaIds.size() < 2 || turmaCorresponde(turmaIds, turmas, 1)) &&
        (turmaIds.size() < 3 || turmaCorresponde(turmaIds, turmas, 2)) &&
        (turmaIds.size() < 4 || turmaCorresponde(turmaIds, turmas, 3)) &&
        (turmaIds.size() < 5 || turmaCorresponde(turmaIds, turmas, 4)) &&
        (turmaIds.size() < 6 || turmaCorresponde(turmaIds, turmas, 5)) &&
        (turmaIds.size() < 7 || turmaCorresponde(turmaIds, turmas, 6)) &&
        (turmaIds.size() < 8 || turmaCorresponde(turmaIds, turmas, 7));
    }

