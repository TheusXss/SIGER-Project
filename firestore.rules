        request.resource.data.localNome == getAfter(/databases/$(database)/documents/aulasExtras/$(aulaId)).data.localNome;
      allow update: if (
          ehProfessor() &&
          get(/databases/$(database)/documents/aulasExtras/$(aulaId)).data.professorUid == request.auth.uid &&
          getAfter(/databases/$(database)/documents/aulasExtras/$(aulaId)).data.statusAula == 'finalizada' &&
          aulaEstaAberta(resource.data.statusAula) &&
          request.resource.data.statusAula == 'finalizada' &&
          request.resource.data.finalizadaEm == getAfter(/databases/$(database)/documents/aulasExtras/$(aulaId)).data.finalizadaEm &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusAula', 'finalizadaEm'])
        ) || (
          ehAdmin() &&
          getAfter(/databases/$(database)/documents/aulasExtras/$(aulaId)).data.statusAula == 'cancelada' &&
          getAfter(/databases/$(database)/documents/aulasExtrasExclusaoSolicitacoes/$(aulaId)).data.status == 'aprovado' &&
